NDOS_SYS_INVALID   EQU 0
NDOS_SYS_ADD       EQU 1
NDOS_SYS_SUB       EQU 2
NDOS_SYS_VERSION   EQU 3
NDOS_SYS_EXIT      EQU 4
NDOS_SYS_PUTCHAR   EQU 5
NDOS_SYS_GETCHAR   EQU 6
NDOS_SYS_PUTS      EQU 7
NDOS_SYS_DISK_INFO EQU 8
NDOS_SYS_READ_FILE EQU 9
NDOS_SYS_READ_DIR  EQU 10
NDOS_SYS_CREATE_FILE EQU 11
NDOS_SYS_READ_LINE EQU 12
NDOS_SYS_DELETE_FILE EQU 13
NDOS_SYS_GET_TICKS EQU 14
NDOS_SYS_FORMAT_U32 EQU 15 ; D1.L value, A1 11-byte buffer; D0.L length
NDOS_SYS_FADD_S EQU 16 ; D1.L + D2.L binary32 -> D0.L binary32
NDOS_SYS_FSUB_S EQU 17 ; D1.L - D2.L binary32 -> D0.L binary32
NDOS_SYS_SET_ATTRIBUTES EQU 18
; Experimental MAME-only large-loader service; not stable NDOS ABI.
NDOS_SYS_READ_LARGE EQU 19
NDOS_SYS_POLLCHAR EQU 20 ; nonblocking: D0=1/D1.B=byte, or D0=0 when no byte

NDOS_OK EQU 0
NDOS_ERR_ARGUMENT EQU -1
NDOS_ERR_IO EQU -2
NDOS_ERR_INVALID_FILESYSTEM EQU -3
NDOS_ERR_UNSUPPORTED EQU -4
NDOS_ERR_NOT_FOUND EQU -5
NDOS_ERR_ALREADY_EXISTS EQU -6
NDOS_ERR_NO_SPACE EQU -7
NDOS_ERR_DIRECTORY_FULL EQU -8
NDOS_ERR_INVALID_NAME EQU -9
NDOS_ERR_CORRUPT_CHAIN EQU -10
NDOS_ERR_BUFFER_TOO_SMALL EQU -11
NDOS_ERR_ACCESS_DENIED EQU -12

; FAT12-compatible directory attribute bits returned by SYS_READ_DIR.
NDOS_ATTR_READ_ONLY EQU $01
NDOS_ATTR_HIDDEN EQU $02
NDOS_ATTR_SYSTEM EQU $04
NDOS_ATTR_VOLUME_LABEL EQU $08
NDOS_ATTR_DIRECTORY EQU $10
NDOS_ATTR_ARCHIVE EQU $20

NDOS_DISK_TOTAL_BYTES       EQU 0
NDOS_DISK_FREE_BYTES        EQU 4
NDOS_DISK_TOTAL_CLUSTERS    EQU 8
NDOS_DISK_FREE_CLUSTERS     EQU 12
NDOS_DISK_BYTES_PER_CLUSTER EQU 16
NDOS_DISK_INFO_SIZE         EQU 20

NDOS_DIR_NAME          EQU 0
NDOS_DIR_ATTRIBUTES    EQU 13
NDOS_DIR_FIRST_CLUSTER EQU 14
NDOS_DIR_SIZE          EQU 16
NDOS_DIR_RESERVED      EQU 20
NDOS_DIR_ENTRY_SIZE    EQU 24

NDOS_LINE_CAPACITY EQU 0
NDOS_LINE_LENGTH   EQU 2
NDOS_LINE_DATA     EQU 4
NDOS_LINE_HEADER_SIZE EQU 4
